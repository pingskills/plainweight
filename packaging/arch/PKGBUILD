# Maintainer: Jeff Plumb <dark.tire0486@plumbmail.com>
pkgname=plainweight
pkgver=0.1.0
pkgrel=1
pkgdesc='A small native weight log for Linux'
arch=('x86_64' 'aarch64')
url='https://github.com/pingskills/plainweight'
license=('MIT')
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'libstdc++' 'qt6-base' 'qt6-declarative')
makedepends=('cmake' 'ninja')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace SKIP with the actual archive checksum after the v0.1.0 GitHub tag exists.
sha256sums=('SKIP')

build() {
  cmake -B build -S "$pkgname-$pkgver" -G Ninja -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr -DPLAINWEIGHT_BUILD_TESTS=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
